# TWILIO CREDENTIALS (from Twilio dashboard) - DO NOT commit real values here.
# Set the real values directly in the Railway dashboard's Variables tab instead.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# YOUR PHONE NUMBERS
TWILIO_PHONE_1=+1XXXXXXXXXX
TWILIO_PHONE_2=+1XXXXXXXXXX

# YOUR PERSONAL PHONE (where calls transfer when you answer)
OPERATOR_PHONE=+1XXXXXXXXXX

# ANTHROPIC API KEY (paste your new key here)
ANTHROPIC_API_KEY=sk-ant-your-new-key-here

# SERVER
PORT=3000
NODE_ENV=production
